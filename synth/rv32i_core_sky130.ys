# Yosys synthesis: RV32IC core (rv32i_core) -> SkyWater SKY130 HD std cells
# Run from this folder:   yosys -l reports/yosys.log rv32i_core_sky130.ys
# Liberty: sky130_fd_sc_hd__tt_025C_1v80.lib copied here as sky130_hd_tt.lib
read_verilog -I../rtl/core ../rtl/core/rv32i_Alu.v ../rtl/core/rv32i_compressed_decoder.v ../rtl/core/rv32i_controller.v ../rtl/core/rv32i_core.v ../rtl/core/rv32i_cs_registers.v ../rtl/core/rv32i_debug_unit.v ../rtl/core/rv32i_decoder.v ../rtl/core/rv32i_ex_block.v ../rtl/core/rv32i_fetch_fifo.v ../rtl/core/rv32i_id_stage.v ../rtl/core/rv32i_if_stage.v ../rtl/core/rv32i_imm_gen.v ../rtl/core/rv32i_int_controller.v ../rtl/core/rv32i_load_store_unit.v ../rtl/core/rv32i_prefetch_buffer.v ../rtl/core/rv32i_register_file.v ../rtl/soc/cluster_clock_gating.v
hierarchy -check -top rv32i_core
synth -top rv32i_core
tee -o reports/pre_map_stat.rpt stat
dfflibmap -liberty sky130_hd_tt.lib -dont_use *lpflow* -dont_use *probe* -dont_use *clkdly* -dont_use *dlygate* -dont_use *dlymetal* -dont_use *_0
abc -liberty sky130_hd_tt.lib -dont_use *lpflow* -dont_use *probe* -dont_use *clkdly* -dont_use *dlygate* -dont_use *dlymetal* -dont_use *_0 -D 10000
opt_clean -purge
hilomap -hicell sky130_fd_sc_hd__conb_1 HI -locell sky130_fd_sc_hd__conb_1 LO
setundef -zero
tee -o reports/area_hier.rpt stat -liberty sky130_hd_tt.lib
read_liberty -lib sky130_hd_tt.lib
tee -o reports/check.rpt check
write_verilog -noattr netlist/rv32i_core_sky130_hier.v
flatten
opt_clean -purge
tee -o reports/area_flat.rpt stat -liberty sky130_hd_tt.lib
write_verilog -noattr netlist/rv32i_core_sky130.v
